# GCP Vertex AI Specific Configuration
# GOOGLE_APPLICATION_CREDENTIALS: "" # Typically not needed on GCE if the VM has a service account with Vertex AI User role.
                                     # Un-comment and set path to service account key file if not using GCE default service account.
VERTEX_AI_PROJECT_ID: "james-sandbox-317709"
VERTEX_AI_LOCATION: "us-central1"
# Ensure your GCE VM's service account has the "Vertex AI User" role or equivalent permissions.

# Variables from .env.example, adjusted for the GCP deployment
COMPOSE_PROJECT_NAME: "wrenai-gcp"
PLATFORM: "linux/amd64"

PROJECT_DIR: "."

# Service Ports
WREN_ENGINE_PORT: "8080"
WREN_ENGINE_SQL_PORT: "7432"
WREN_AI_SERVICE_PORT: "5555"
WREN_UI_PORT: "3000"

# AI Service Settings
QDRANT_HOST: "qdrant"

# Vendor Keys - Add placeholders, user should fill these if using these services
OPENAI_API_KEY: ""
LANGFUSE_SECRET_KEY: ""
LANGFUSE_PUBLIC_KEY: ""

# Versioning (User should update these to desired or latest stable versions)
WREN_PRODUCT_VERSION: "0.22.2"
WREN_ENGINE_VERSION: "0.15.13"
WREN_AI_SERVICE_VERSION: "0.22.4"
WREN_UI_VERSION: "0.27.4"

# User ID for telemetry
USER_UUID: "" # Generate a UUID v4 if needed, or leave for user

# Telemetry settings
POSTHOG_API_KEY: "phc_nhF32aj4xHXOZb0oqr2cn4Oy9uiWzz6CCP4KZmRq9aE"
POSTHOG_HOST: "https://app.posthog.com"
TELEMETRY_ENABLED: "true"
GENERATION_MODEL: "vertex_ai/gemini-2.5-pro-preview-05-06"

# Port forwarding for host access
HOST_PORT: "3000"
AI_SERVICE_FORWARD_PORT: "5555"

# Wren UI specific
EXPERIMENTAL_ENGINE_RUST_VERSION: "false"
